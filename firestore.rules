rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função para verificar se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Função para obter o tenantId e o role (perfil) do usuário logado
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Regras da Coleção de Usuários
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Regras Multi-tenant (Isolamento por Clínica)
    match /clinics/{tenantId} {
      // Qualquer usuário da clínica pode ler os dados básicos dela
      allow read: if isAuthenticated() && getUserData().tenantId == tenantId;
      
      // Apenas o Admin da clínica pode alterar dados dela (ex: Chave PIX)
      allow write: if isAuthenticated() && getUserData().tenantId == tenantId && getUserData().role == 'admin';

      // Subcoleções: Pacientes e Agendamentos (Acesso total para a equipe da clínica)
      match /patients/{document=**} {
        allow read, write: if isAuthenticated() && getUserData().tenantId == tenantId;
      }
      
      match /appointments/{document=**} {
        allow read, write: if isAuthenticated() && getUserData().tenantId == tenantId;
      }

      // Subcoleção: Faturamento (Acesso EXCLUSIVO do Admin)
      match /invoices/{document=**} {
        allow read, write: if isAuthenticated() && getUserData().tenantId == tenantId && getUserData().role == 'admin';
      }
    }
  }
}